{
  "host": "@BIND_ADDR@",
  "port": @PORT@,
  "root": "Public",
  "accessLog": { "path": "logs/access.log", "format": "combined" },
  "auth": [
    {
      "paths": ["/laya/predict", "/laya/stats"],
      "realm": "System 1",
      "tokens": [{ "name": "parallax", "sha256": "@TOKEN_SHA256@" }]
    }
  ],
  "proxy": [
    {
      "path": "/laya",
      "upstream": "http://127.0.0.1:@LAYA_PORT@",
      "stripPrefix": true,
      "forwardedHeaders": "x-forwarded",
      "timeouts": { "connect": 2, "response": 20, "idle": 60 },
      "retries": 0,
      "health": { "failures": 3, "cooldown": 5, "path": "/health", "interval": 10 }
    }
  ]
}
