{
  "port": 8080,
  "defaultIndex": "index.html",
  "defaultMimeType": "application/octet-stream",
  "caching": {
    "enabled": true,
    "maxAge": 3600
  },
  "mimeTypes": [
    { "pathExtensions": ["html", "htm"], "contentType": "text/html" },
    { "pathExtensions": ["css"], "contentType": "text/css" },
    { "pathExtensions": ["js"], "contentType": "application/javascript" },
    { "pathExtensions": ["png"], "contentType": "image/png" },
    { "pathExtensions": ["jpg", "jpeg"], "contentType": "image/jpeg" },
    { "pathExtensions": ["gif"], "contentType": "image/gif" },
    { "pathExtensions": ["json"], "contentType": "application/json" },
    { "pathExtensions": ["txt"], "contentType": "text/plain" },
    { "pathExtensions": ["ico"], "contentType": "image/x-icon" }
  ],
  "blockList": [
    "/http.config"
  ]
}
