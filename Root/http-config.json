{
  "host": "127.0.0.1",
  "port": 8080,
  "root": "Public",
  "index": ["index.html"],
  "caching": {
    "enabled": true,
    "maxAge": 3600
  },
  "maxConnections": 1024,
  "maxBodySize": 10485760,
  "timeouts": {
    "header": 10,
    "idle": 5,
    "body": 30,
    "send": 30,
    "linger": 2
  },
  "drainTimeout": 10,
  "http2": {
    "enabled": true,
    "cleartext": false,
    "maxConcurrentStreams": 100,
    "initialWindowSize": 65535
  },
  "transport": "bsd",
  "defaultMimeType": "application/octet-stream",
  "mimeTypes": {},
  "blockList": [
    "http-config.json",
    ".git",
    ".DS_Store"
  ],
  "errorPages": {
    "404": "Custom/404.html",
    "405": "Custom/405.html"
  }
}
